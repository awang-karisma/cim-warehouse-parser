# Standalone Dockerfile (backend only without embedded frontend)
FROM golang:1.27-alpine AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . ./

ARG VERSION=dev
ARG COMMIT=none
ARG DATE=unknown

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w \
    -X github.com/awang-karisma/warehouse-parser/pkg/version.Version=${VERSION} \
    -X github.com/awang-karisma/warehouse-parser/pkg/version.Commit=${COMMIT} \
    -X github.com/awang-karisma/warehouse-parser/pkg/version.Date=${DATE}" \
    -o /app/warehouse-server ./cmd/warehouse-server

FROM alpine:3.21
RUN apk --no-cache add ca-certificates tzdata
WORKDIR /app
COPY --from=builder /app/warehouse-server /app/warehouse-server

ENV PORT=8080 \
    DB_PATH=/data/warehouse.db

VOLUME ["/data"]
EXPOSE 8080

ENTRYPOINT ["/app/warehouse-server"]
