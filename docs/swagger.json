{
    "swagger": "2.0",
    "info": {
        "description": "Read-only HTTP REST API server for warehouse order tracking data with background Google Sheets synchronization.",
        "title": "Warehouse Order Tracking API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Warehouse Engineering",
            "url": "https://github.com/awang-karisma/warehouse-parser"
        },
        "license": {
            "name": "MIT",
            "url": "https://opensource.org/licenses/MIT"
        },
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/v1/items": {
            "get": {
                "description": "List normalized line items with pagination and filters (customer, nama_barang, status_order, date, order_number, ecatalog_number)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "items"
                ],
                "summary": "List items",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Customer name or substring",
                        "name": "customer",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Item name or substring",
                        "name": "nama_barang",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Order status (e.g. SELESAI, PROSES, PENDING)",
                        "name": "status_order",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Date (e.g. 02/01/2026)",
                        "name": "date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Order number or E-Katalog number (e.g. EP-01...)",
                        "name": "order_number",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Alias for order_number",
                        "name": "ecatalog_number",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of items to return (default 50, max 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Offset for pagination (default 0)",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.ItemsResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/orders": {
            "get": {
                "description": "List orders with pagination and filters (customer, date, area, order_number, ecatalog_number)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "List orders",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Customer name or substring",
                        "name": "customer",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Order date (e.g. 02/01/2026)",
                        "name": "date",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Area name or substring",
                        "name": "area",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Order number or E-Katalog number (e.g. EP-01...)",
                        "name": "order_number",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Alias for order_number",
                        "name": "ecatalog_number",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Number of items to return (default 50, max 1000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Offset for pagination (default 0)",
                        "name": "offset",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.OrdersResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/orders/{id}": {
            "get": {
                "description": "Get a single order by its ID with all line items",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "orders"
                ],
                "summary": "Get order by ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Order ID",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Order"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/stats": {
            "get": {
                "description": "Get aggregated summary statistics of orders and items",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "stats"
                ],
                "summary": "Get stats",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/storage.Stats"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/status": {
            "get": {
                "description": "Get background worker synchronization status and work hours info",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "worker"
                ],
                "summary": "Get worker status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.StatusResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/sync": {
            "post": {
                "description": "Trigger an immediate synchronization from remote data source into local storage (force=true)",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "worker"
                ],
                "summary": "Trigger manual sync",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.SyncResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "503": {
                        "description": "Service Unavailable",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/health": {
            "get": {
                "description": "Check the health and readiness of the API service",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.HealthResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "not found"
                }
            }
        },
        "api.HealthResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "api.ItemsResponse": {
            "type": "object",
            "properties": {
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.NormalizedItem"
                    }
                },
                "limit": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "api.OrdersResponse": {
            "type": "object",
            "properties": {
                "limit": {
                    "type": "integer"
                },
                "offset": {
                    "type": "integer"
                },
                "orders": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.Order"
                    }
                },
                "total": {
                    "type": "integer"
                }
            }
        },
        "api.StatusResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                },
                "is_inside_work_hours": {
                    "type": "boolean"
                },
                "last_duration_ms": {
                    "type": "integer"
                },
                "last_record": {
                    "$ref": "#/definitions/storage.SyncRecord"
                },
                "last_sync": {
                    "type": "string"
                },
                "next_sync": {
                    "type": "string"
                },
                "status": {
                    "type": "string",
                    "example": "IDLE"
                }
            }
        },
        "api.SyncResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "sync completed successfully"
                },
                "record": {
                    "$ref": "#/definitions/storage.SyncRecord"
                },
                "status": {
                    "type": "string",
                    "example": "ok"
                }
            }
        },
        "model.NormalizedItem": {
            "type": "object",
            "properties": {
                "area": {
                    "type": "string"
                },
                "belum_terkirim": {
                    "type": "string"
                },
                "catatan": {
                    "type": "string"
                },
                "customer": {
                    "type": "string"
                },
                "ecatalog_number": {
                    "type": "string"
                },
                "jumlah": {
                    "type": "string"
                },
                "jumlah_terkirim": {
                    "type": "string"
                },
                "keterangan": {
                    "type": "string"
                },
                "lead_time_pengiriman": {
                    "type": "string"
                },
                "nama_barang": {
                    "type": "string"
                },
                "order_number": {
                    "type": "string"
                },
                "row_index": {
                    "type": "integer"
                },
                "satuan": {
                    "type": "string"
                },
                "status_barang": {
                    "type": "string"
                },
                "status_order": {
                    "type": "string"
                },
                "tanggal": {
                    "type": "string"
                },
                "tanggal_pengiriman": {
                    "type": "string"
                }
            }
        },
        "model.Order": {
            "type": "object",
            "properties": {
                "area": {
                    "type": "string"
                },
                "customer": {
                    "type": "string"
                },
                "ecatalog_number": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "items": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/model.OrderItem"
                    }
                },
                "order_number": {
                    "type": "string"
                },
                "tanggal": {
                    "type": "string"
                }
            }
        },
        "model.OrderItem": {
            "type": "object",
            "properties": {
                "belum_terkirim": {
                    "type": "string"
                },
                "catatan": {
                    "type": "string"
                },
                "ecatalog_number": {
                    "type": "string"
                },
                "jumlah": {
                    "type": "string"
                },
                "jumlah_terkirim": {
                    "type": "string"
                },
                "keterangan": {
                    "type": "string"
                },
                "lead_time_pengiriman": {
                    "type": "string"
                },
                "nama_barang": {
                    "type": "string"
                },
                "order_number": {
                    "type": "string"
                },
                "row_index": {
                    "type": "integer"
                },
                "satuan": {
                    "type": "string"
                },
                "status_barang": {
                    "type": "string"
                },
                "status_order": {
                    "type": "string"
                },
                "tanggal_pengiriman": {
                    "type": "string"
                }
            }
        },
        "storage.Stats": {
            "type": "object",
            "properties": {
                "status_counts": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    }
                },
                "total_items": {
                    "type": "integer"
                },
                "total_orders": {
                    "type": "integer"
                },
                "unique_areas": {
                    "type": "integer"
                },
                "unique_customers": {
                    "type": "integer"
                }
            }
        },
        "storage.SyncRecord": {
            "type": "object",
            "properties": {
                "error_message": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "items_count": {
                    "type": "integer"
                },
                "orders_count": {
                    "type": "integer"
                },
                "status": {
                    "type": "string"
                },
                "synced_at": {
                    "type": "string"
                }
            }
        }
    }
}