# Server Configuration
SERVER_PORT=8080

# SQLite Database
DB_PATH=data/warehouse.db

# Background Sync Worker Configuration
SYNC_INTERVAL=15m
SYNC_WORK_HOURS_START=08:00
SYNC_WORK_HOURS_END=17:00
SYNC_TIMEZONE=Asia/Makassar
SYNC_BYPASS_WORK_HOURS_ON_FIRST_SYNC=true

# Remote Google Sheets (optional - falls back to CSVFallbackPath if not provided)
SPREADSHEET_ID=1X3FqpqpP7utvkyFK98YE863ItVsvmmUrBTBsGfuzK3s
SHEET_NAME=PESANAN
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_API_KEY=

# Local CSV Fallback Path
CSV_FALLBACK_PATH=testdata/orders_sample.csv

# Authentication (optional - leave GOOGLE_CLIENT_ID empty to disable auth)
GOOGLE_CLIENT_ID=
JWT_SECRET=
SUPERADMIN_EMAILS=
